{%- comment -%}
  Barra delle categorie del blog, condivisa da /blog-N/ e da tutte le
  /categoria/*/. Uso: {% include 'categorie-nav.njk', attivo: 'videogiochi' %}
  (attivo: 'tutti' per la pagina Tutti). Liquid, perché la includono pagine .md.
{%- endcomment -%}
  <nav class="tdbc-categorie-nav" aria-label="Categorie del blog">
    <a href="/blog-0/" class="tdbc-button tdbc-button-outlined tdbc-button--small{% if attivo == 'tutti' %} is-active{% endif %}">Tutti</a>
    <a href="/categoria/videogiochi-0/" class="tdbc-button tdbc-button-outlined tdbc-button--small{% if attivo == 'videogiochi' %} is-active{% endif %}">Videogiochi</a>
    <a href="/categoria/musica-0/" class="tdbc-button tdbc-button-outlined tdbc-button--small{% if attivo == 'musica' %} is-active{% endif %}">Musica</a>
    <a href="/categoria/internet-0/" class="tdbc-button tdbc-button-outlined tdbc-button--small{% if attivo == 'internet' %} is-active{% endif %}">Internet</a>
    <a href="/categoria/film-serie-0/" class="tdbc-button tdbc-button-outlined tdbc-button--small{% if attivo == 'film-serie' %} is-active{% endif %}">Film, Serie &amp; Fumettame</a>
    <a href="/categoria/xabologia-0/" class="tdbc-button tdbc-button-outlined tdbc-button--small{% if attivo == 'xabologia' %} is-active{% endif %}">Xabologia</a>
    <a href="/categoria/english-0/" class="tdbc-button tdbc-button-outlined tdbc-button--small is-english{% if attivo == 'english' %} is-active{% endif %}" lang="en" hreflang="en">🇬🇧 English</a>
  </nav>
