{%- comment -%}
  Barra delle categorie del blog, condivisa da /blog-N/ e da tutte le
  /categoria/*/. Uso: {% include 'categorie-nav.njk', attivo: 'videogiochi' %}
  (attivo: 'tutti' per la pagina All, /blog-N/). Liquid, perché la includono pagine .md.
  Stile "fumettoso" in _buttons.scss (.cat-btn): ogni bottone ha il suo colore
  in --tdbc-cat (hover/attivo) e un'icona SVG a tratto che segue currentColor.
{%- endcomment -%}
  <nav class="tdbc-categorie-nav" aria-label="Categorie del blog">
    <a href="/blog-0/" class="cat-btn cat-btn--tutti{% if attivo == 'tutti' %} is-active{% endif %}"{% if attivo == 'tutti' %} aria-current="page"{% endif %}><svg class="cat-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5"/><rect x="13.5" y="3" width="7.5" height="7.5"/><rect x="3" y="13.5" width="7.5" height="7.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5"/></svg>All</a>
    <a href="/categoria/videogiochi-0/" class="cat-btn cat-btn--videogiochi{% if attivo == 'videogiochi' %} is-active{% endif %}"{% if attivo == 'videogiochi' %} aria-current="page"{% endif %}><svg class="cat-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10a5 5 0 0 1 5 5v1.5a3.5 3.5 0 0 1-6.3 2.1L14.5 14h-5l-1.2 1.6A3.5 3.5 0 0 1 2 13.5V12a5 5 0 0 1 5-5z"/><path d="M7 9.5v4M5 11.5h4"/><circle cx="16" cy="10.5" r=".6"/><circle cx="18" cy="12.5" r=".6"/></svg>Video Games</a>
    <a href="/categoria/musica-0/" class="cat-btn cat-btn--musica{% if attivo == 'musica' %} is-active{% endif %}"{% if attivo == 'musica' %} aria-current="page"{% endif %}><svg class="cat-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg>Music</a>
    <a href="/categoria/internet-0/" class="cat-btn cat-btn--internet{% if attivo == 'internet' %} is-active{% endif %}"{% if attivo == 'internet' %} aria-current="page"{% endif %}><svg class="cat-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>Internet</a>
    <a href="/categoria/film-serie-0/" class="cat-btn cat-btn--film-serie{% if attivo == 'film-serie' %} is-active{% endif %}"{% if attivo == 'film-serie' %} aria-current="page"{% endif %}><svg class="cat-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="9" width="18" height="12"/><path d="M3 9l1.5-5 17 2.5L21 9M8 4.5l2 4.5M13.5 5.5l2 3.5"/></svg>Movies, TV &amp; Fumettame</a>
    <a href="/categoria/xabologia-0/" class="cat-btn cat-btn--xabologia{% if attivo == 'xabologia' %} is-active{% endif %}"{% if attivo == 'xabologia' %} aria-current="page"{% endif %}><svg class="cat-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v11H11l-5 4.5V15H4z"/><path d="M9 8l6 4M15 8l-6 4"/></svg>Xabologia</a>
    <a href="/categoria/english-0/" class="cat-btn cat-btn--english{% if attivo == 'english' %} is-active{% endif %}"{% if attivo == 'english' %} aria-current="page"{% endif %} lang="en" hreflang="en"><span class="cat-btn__flag" aria-hidden="true">🇬🇧</span>English</a>
  </nav>
  {%- comment -%} su mobile la barra scorre: porta in vista la categoria attiva {%- endcomment -%}
  <script>(function(){var n=document.currentScript.previousElementSibling,a=n&&n.querySelector('.is-active');if(a&&n.scrollWidth>n.clientWidth)n.scrollLeft=a.offsetLeft-16;})();</script>
