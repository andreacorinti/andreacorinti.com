<nav aria-label="Menu principale" class="tdbc-sitenav">
  <a class="tdbc-skip-link" href="#main-content">Vai al contenuto</a>
  <div class="tdbc-sitenav__container">
    <div class="tdbc-sitenav__brand">
      <!--<a id="tdbc-siteid" href="/">{{ meta.siteName }}</a>-->
      {#- voce attiva: BLOG copre anche categorie e singoli post #}
      {%- set u = page.url or '' %}
      {%- set navAttiva = '' %}
      {%- if u == '/' %}{% set navAttiva = 'home' %}
      {%- elif u.startsWith('/blog') or u.startsWith('/categoria') or u.startsWith('/posts') %}{% set navAttiva = 'blog' %}
      {%- elif u.startsWith('/projects') or u.startsWith('/progetti') %}{% set navAttiva = 'projects' %}
      {%- elif u.startsWith('/about') or u.startsWith('/en/about') %}{% set navAttiva = 'about' %}
      {%- elif u.startsWith('/contact') %}{% set navAttiva = 'contact' %}{% endif %}
      <ul class="tdbc-sitenav__navlist tdbc-list-unstyled">
        <li><a href="/"{% if navAttiva == 'home' %} aria-current="page"{% endif %}>HOME</a></li>
        <li><a href="/blog-0"{% if navAttiva == 'blog' %} aria-current="page"{% endif %}>BLOG</a></li>
        <li><a href="/projects"{% if navAttiva == 'projects' %} aria-current="page"{% endif %}>PROJECTS</a></li>
        <li><a href="/about"{% if navAttiva == 'about' %} aria-current="page"{% endif %}>ABOUT</a></li>
        <li><a href="/contact"{% if navAttiva == 'contact' %} aria-current="page"{% endif %}>CONTACT</a></li>
      </ul>
    </div>
    <div class="search-container" role="search">
      <label for="search-input" class="tdbc-visually-hidden">Cerca nel sito</label>
      <input type="text" id="search-input" placeholder="Search..." />
      <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg>
      <ul id="search-results"></ul>
    </div>
    <button type="button" id="theme-toggle" class="tdbc-icon-button" aria-label="Attiva tema chiaro">
      <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" fill="currentColor"/>
        <g fill="currentColor">
          <rect x="11" y="1" width="2" height="3" rx="1"/>
          <rect x="11" y="1" width="2" height="3" rx="1" transform="rotate(45 12 12)"/>
          <rect x="11" y="1" width="2" height="3" rx="1" transform="rotate(90 12 12)"/>
          <rect x="11" y="1" width="2" height="3" rx="1" transform="rotate(135 12 12)"/>
          <rect x="11" y="1" width="2" height="3" rx="1" transform="rotate(180 12 12)"/>
          <rect x="11" y="1" width="2" height="3" rx="1" transform="rotate(225 12 12)"/>
          <rect x="11" y="1" width="2" height="3" rx="1" transform="rotate(270 12 12)"/>
          <rect x="11" y="1" width="2" height="3" rx="1" transform="rotate(315 12 12)"/>
        </g>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 1020.354 15.354z"/>
      </svg>
    </button>
  </div>
</nav>