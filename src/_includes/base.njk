<!DOCTYPE html>
<html lang="{%- if lang -%}{{ lang }}{%- else -%}it{%- endif -%}">
{# seoTitle overrides `title` for <title>/og:title/twitter:title only —
   for pages where `title` is also rendered as visible content (e.g. the
   resume's H1 is the person's name), seoTitle lets the browser-tab/SERP
   title differ from that without changing the visible page. #}
{%- set effectiveTitle %}{% if seoTitle %}{{ seoTitle }}{% else %}{{ title }}{% endif %}{% endset -%}
{%- set pageTitle %}{% if effectiveTitle %}{{ effectiveTitle | safe }} | {% endif %}{{ meta.siteName }}{% endset -%}
{%- set pageOgTitle %}{% if effectiveTitle %}{{ effectiveTitle | safe }}{% else %}{{ meta.siteName }}{% endif %}{% endset -%}
{%- set pageDescription %}{% if sommario %}{{ sommario }}{% elif description %}{{ description }}{% else %}{{ meta.siteDescription }}{% endif %}{% endset -%}
{# Pages without their own `immagine` fell back to /previews/{slug}.png,
   a path nothing in this project ever generates — a permanently-broken
   social preview image on every page that hits this branch (homepage,
   about, contact, projects...). Falls back to the site's own avatar
   (already used elsewhere, e.g. the homepage) instead of a dead link. #}
{%- set pageSocialImg %}{{ meta.url }}/img/avatar3.jpg{% endset -%}
<head>
    <!-- Generated from the 11ty Netlify Jumpstart: https://github.com/5t3ph/11ty-netlify-jumpstart -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {# Inline and synchronous (not deferred) on purpose: it has to set
       data-theme before the stylesheet below paints, or a light-mode
       visitor sees a flash of the dark theme on every page load. #}
    <script>
      (function () {
        try {
          if (localStorage.getItem("theme") === "light") {
            document.documentElement.setAttribute("data-theme", "light");
          }
        } catch (e) {}
      })();
    </script>
    <title>{{ pageTitle | safe }}</title>
    <meta
      name="description"
      content="{{ pageDescription | safe }}"
    />
    <link rel="canonical" href="{{ meta.url }}{{ page.url }}" />
    {# `translation` is a per-post opt-in field (not every post has one): the
       relative URL of the same post in the other language. hreflang tells
       search engines the two pages are translations of each other rather
       than duplicate/unrelated content; x-default keeps Italian as the
       fallback for visitors whose language doesn't match either. #}
    {%- if translation %}
    {%- set otherLangCode %}{% if lang and lang.startsWith('en') %}it{% else %}en{% endif %}{% endset -%}
    {%- set currentLangCode %}{% if otherLangCode == 'it' %}en{% else %}it{% endif %}{% endset -%}
    {%- set itUrl %}{% if currentLangCode == 'it' %}{{ meta.url }}{{ page.url }}{% else %}{{ meta.url }}{{ translation }}{% endif %}{% endset -%}
    <link rel="alternate" hreflang="{{ currentLangCode }}" href="{{ meta.url }}{{ page.url }}" />
    <link rel="alternate" hreflang="{{ otherLangCode }}" href="{{ meta.url }}{{ translation }}" />
    <link rel="alternate" hreflang="x-default" href="{{ itUrl }}" />
    {%- endif %}
    <link rel="icon" href="{{ '/favicon.png' | url }}" />
    <link rel="preload" href="{{ '/fonts/teko.woff' | url }}" as="font" type="font/woff" crossorigin="anonymous">
    <link href="{{ '/css/style.css' | url }}" rel="stylesheet" />
    <link href="https://mastodon.social/@Xabacadabra" rel="me">

    {%- set socialImage %}{% if immagine %}{% if immagine.startsWith('http') %}{{ immagine }}{% else %}{{ meta.url }}{{ immagine }}{% endif %}{% else %}{{ pageSocialImg }}{% endif %}{% endset -%}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@XabCorinti" />
    <meta name="fediverse:creator" content="@Xabacadabra@mastodon.social">
    <meta name="twitter:title" content="{{ pageOgTitle | safe }}" />
    <meta name="twitter:description" content="{{ pageDescription | safe }}" />
    <meta name="twitter:image" content="{{ socialImage }}" />

    <meta property="og:title" content="{{ pageOgTitle | safe }}" />
    <meta property="og:description" content="{{ pageDescription | safe }}" />
    <meta property="og:image" content="{{ socialImage }}" />
    <meta property="og:url" content="{{ meta.url }}{{ page.url }}" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="{{ meta.siteName }}" />

    {# There's a footballer with the same name; this Person entity with
       sameAs links to verified profiles is the standard signal for search
       engines to tell the two apart, rather than relying on text alone. #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Andrea Corinti",
      "alternateName": "Xab",
      "url": "{{ meta.url }}",
      "image": "{{ meta.url }}/img/avatar3.jpg",
      "jobTitle": "Freelance Content & E-Learning Platform Coordinator",
      "worksFor": {
        "@type": "Organization",
        "name": "Edizioni Edilingua"
      },
      "sameAs": [
        "https://www.linkedin.com/in/andrea-corinti/",
        "https://mastodon.social/@Xabacadabra",
        "https://www.instagram.com/xabacadabra/",
        "https://x.com/XabCorinti",
        "https://github.com/andreacorinti"
      ]
    }
    </script>

    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed for {{ meta.siteName }}"
      href="/feed/"
    />
    {% if comments %}
    {# mastodon-comments.js / misskey-comments.js are only embedded inside
       actual post content (<mastodon-comments>/<misskey-comments> tags in
       post markdown), so these only need loading on post pages — not on
       every page site-wide (resume, about, homepage...). They also both
       depended on dompurify + font-awesome, previously loaded twice each
       (once per widget) — real duplicate JS/CSS, now loaded once. #}
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/2.4.1/purify.min.js" integrity="sha512-uHOKtSfJWScGmyyFr2O2+efpDx2nhwHU2v7MVeptzZoiC7bdF6Ny/CmZhN2AwIK1oCFiVQQ5DA/L9FSzyPNu6Q==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <script type="module" src="../../../js/mastodon-comments.js"></script>
    <script type="module" src="../../../js/misskey-comments.js"></script>
    {% endif %}

    <!-- webmentions -->
    <link rel="webmention" href="https://webmention.io/www.andreacorinti.com/webmention" />
    <link rel="pingback" href="https://webmention.io/www.andreacorinti.com/xmlrpc" />

    <!-- analytics: cookieless, no banner needed -->
    <script data-goatcounter="https://xabacadabra.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>

  </head>
  <body>
    {{ content | safe }}

    <footer class="tdbc-background--secondary">
      <div class="tdbc-container tdbc-text-align-center">
        <div class="tdbc-row tdbc-ink--light tdbc-mx-auto">
          <p class="tdbc-mb-none">&copy; 2018 - {% year %} <a class="h-card u-url" rel="me author" href="https://www.andreacorinti.com/about">{{ meta.siteName }}</a> • {% packageVersion %}</p>
          <span class="tdbc-row tdbc-row--center-content">
          <a rel="me" href="https://mastodon.social/@Xabacadabra" class="tdbc-icon-button tdbc-ink--light" aria-label="Mastodon">
  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
    <path fill="currentColor" d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"/>
  </svg>
</a>
          </span>
        </div>
      </div>
      <a rel="me" class="p-author h-card" href="https://mastodon.social/@Xabacadabra" style="display: none;">Andrea Corinti</a>
      <a rel="me" class="p-author h-card" href="https://mastodon.social/@Xabacadabra" style="display: none;">Andrea Corinti</a>
    </footer>
        <!-- ricerca -->
    <script src="/js/search.js" defer></script>
    <script src="/js/theme-toggle.js" defer></script>
  </body>
</html>
