---
layout: base.njk
---

<body class="resume-page" style="background-color:white;">

<header class="tdbc-hero">
  <div class="tdbc-container" style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
    <!-- Immagine a sinistra -->
    <img src="{{ immagine }}" alt="Andrea Corinti" class="resumeAvatar">

    <!-- Testo a destra (titolo e descrizione) -->
    <div>
      <h1 class="tdbc-ink--primary tdbc-mb-none" style="color:black; margin-top: 0;">{{ title }}</h1>
      <h2 class="tdbc-lead tdbc-ink--gray tdbc-mt-md" style="color:black; margin-bottom: 0;">
        {{ description }}
      </h2>
    </div>

    <button type="button" class="tdbc-button tdbc-button--small resume-print-btn no-print" onclick="window.print()">🖨️ Stampa / PDF</button>
  </div>
</header>

<main class="tdbc-container" style="color:black;">
  <article class="tdbc-mx-auto no-print">
    {{ content | safe }}
  </article>

  <!-- Print-only duplicate: same content regrouped into a classic CV
       sidebar + main column. Hidden on screen; see resumeSection in
       .eleventy.js and the print rules in _resume.scss. -->
  <div class="resume-print-columns print-only" aria-hidden="true">
    <div class="resume-print-sidebar">
      {{ content | resumeSection(["--contacts-and-personal-info", "--it-skills", "--other-skills"]) | safe }}
    </div>
    <div class="resume-print-main">
      {{ content | resumeSection(["--work-experience", "--publications", "--education", "--languages", "--certifications"]) | safe }}
    </div>
  </div>
</main>