---
layout: base.njk
---

<span itemprop="author" itemscope itemtype="https://schema.org/Person">
  <meta itemprop="name" content="Andrea Corinti">
</span>

<span itemprop="publisher" itemscope itemtype="https://schema.org/Person">
    <!--<span itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
      <img src="/images/logo.jpg"/>
      <meta itemprop="url" content="/images/logo.jpg">
      <meta itemprop="width" content="600">
      <meta itemprop="height" content="60">
    </span> /*logo*/--> 
    <meta itemprop="name" content="Andrea Corinti">
</span>
<span itemprop="headline" content="{{ sommario }}"></span>


{%- set schemaImage %}{% if immagine %}{% if immagine.startsWith('http') %}{{ immagine }}{% else %}{{ meta.url }}{{ immagine }}{% endif %}{% endif %}{% endset -%}
{%- set schemaUrl %}{{ meta.url }}{{ page.url }}{% endset -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": {{ title | dump | safe }},
  "description": {{ sommario | dump | safe }},
  {% if schemaImage %}"image": {{ schemaImage | dump | safe }},{% endif %}
  "datePublished": {{ date | dateToRfc3339 | dump | safe }},
  "inLanguage": {{ (lang or "it-IT") | dump | safe }},
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ schemaUrl | dump | safe }} },
  "author": { "@type": "Person", "name": "Andrea Corinti", "url": {{ meta.url | dump | safe }} }
}
</script>

{% include 'sitenav.njk' %}

<header class="tdbc-hero">
  <div class="tdbc-container">
    <h1 class="tdbc-ink--primary tdbc-mb-none">{{ title }}</h1>
    <time itemprop="datePublished" class="dt-published" content="{{ date }}">{{ date | dateDisplay }}</time>
    <img src="{{ immagine }}" alt="{{ title }}" title="{{ title }}" itemprop="image">
    <h2 class="tdbc-lead tdbc-content-maxlength tdbc-ink--gray tdbc-mt-md tdbc-mx-auto">
      {{ subtitle }}
    </h2>
  </div>
</header>
<main id="main-content" class="tdbc-container h-entry">
  <article class="tdbc-mx-auto e-content p-name">
    {{ content | safe }}
  <section>
    <!--<h3>Utterances</h3>
    <script src="https://utteranc.es/client.js"
        repo="andreacorinti/andreacorinti.com"
        issue-term="pathname"
        theme="github-dark"
        crossorigin="anonymous"
        async>
    </script>-->
    </section>
  </article>
</main>
