---
layout: base.njk
comments: true
---

{# Qui dovrai inserire i link per l'endpoint Webmention, solitamente nel <head> del tuo base.njk. #}
{# Se usi webmention.io, devi aver configurato il tuo dominio lì. #}
{# Esempio: #}
{# <link rel="webmention" href="https://webmention.io/yourdomain.com/webmention" /> #}
{# <link rel="pingback" href="https://webmention.io/yourdomain.com/xmlrpc" /> #}

{%- set schemaImage %}{% if immagine %}{% if immagine.startsWith('http') %}{{ immagine }}{% else %}{{ meta.url }}{{ immagine }}{% endif %}{% endif %}{% endset -%}
{%- set schemaUrl %}{{ meta.url }}{{ page.url }}{% endset -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ sommario | dump | safe }},
  {% if schemaImage %}"image": {{ schemaImage | dump | safe }},{% endif %}
  "datePublished": {{ date | dateToRfc3339 | dump | safe }},
  "dateModified": {{ date | dateToRfc3339 | dump | safe }},
  "inLanguage": {{ (lang or "it-IT") | dump | safe }},
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ schemaUrl | dump | safe }} },
  "author": { "@type": "Person", "name": "Andrea Corinti", "url": {{ meta.url | dump | safe }} },
  "publisher": { "@type": "Person", "name": "Andrea Corinti" }
}
</script>

{% include 'sitenav.njk' %}

<header class="tdbc-hero">
  <div class="tdbc-container">
    {# Il titolo del post con la classe p-name. Va bene qui. #}
    <h1 class="tdbc-ink--primary tdbc-mb-none p-name">{{ title }}</h1>
    {# La data di pubblicazione con la classe dt-published. Assicurati che htmlDateString formatti in ISO 8601. #}
    <time class="dt-published" datetime="{{ date | htmlDateString }}">{{ date | dateDisplay }}</time>
    {% heroImage immagine, title %}
    {# Il sottotitolo/sommario del post con la classe p-summary. #}
    <h2 class="tdbc-lead tdbc-content-maxlength tdbc-ink--gray tdbc-mt-md tdbc-mx-auto">
      <span class="p-summary">{{ subtitle }}</span>
    </h2>
  </div>
</header>

{# Questo è il contenitore principale del tuo post e DEVE avere la classe h-entry. #}
{# Ho spostato l'intera sezione 'main' all'interno di un unico h-entry. #}
<main id="main-content" class="tdbc-container">
  <article class="tdbc-mx-auto h-entry">
    {# L'URL permanente del post con la classe u-url. CRUCIALE per Bridgy Fed. #}
    <a class="u-url" href="{{ meta.url }}{{ page.url }}" hidden></a>

    {# L'autore del post - Rimosso il <p> esterno, messo direttamente sull'<a> #}
    <a class="p-author h-card u-author-hidden" href="https://www.andreacorinti.com">Andrea Corinti</a>

    {# Il contenuto effettivo del post con la classe e-content. NON aggiungere qui p-name. #}
    <div class="e-content">
      {{ content | safe }}
    </div>

    {# Se vuoi aggiungere categorie #}
    {# {% if categories %}
    <div>
      Categorizzato in:
      {% for category in categories %}
      <a rel="tag" class="p-category" href="/categorie/{{ category | slug }}">{{ category }}</a>{% if not loop.last %}, {% endif %}
      {% endfor %}
    </div>
    {% endif %} #}

    <section>
      {# La sezione commenti (Utterances) può rimanere, ma non è direttamente legata a Bridgy Fed/Webmention #}
      </section>
  </article>
</main>